# Copy this file to ".env" and fill in real values before running the server.

# Secret key used to sign JWT login tokens. Use any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# Your OpenAI API key, used to generate recipes. Get one at platform.openai.com.
OPENAI_API_KEY=

# Chat model used for recipe generation.
OPENAI_MODEL=gpt-4o-mini
